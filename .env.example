# =====================================================================
# Tech Sahaya - Environment Configuration Template
# Keep real secrets in backend/.env (ignored by Git)
# =====================================================================

# --- AI & Reasoning Layer ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# --- Voice Layer (Sarvam AI STT & TTS) ---
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3

SARVAM_TTS_VOICE=ishita

VOICE_PROVIDER=sarvam

# Deprecated/optional external integrations
BHASHINI_API_KEY=

# --- Authentication & Database ---
AUTH_ADAPTER=local
DATABASE_URL=sqlite:///./tech_sahaya_secure.db
FAISS_INDEX_PATH=./data/faiss_index

# Supabase Auth (when AUTH_ADAPTER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security, Rate Limiting & Uploads ---
MAX_UPLOAD_SIZE=5242880
RATE_LIMIT_PER_MINUTE_DEFAULT=60
RATE_LIMIT_PER_MINUTE_AI=10
PROMPT_INJECTION_GUARD_ENABLED=true
MAX_CHAT_INPUT_LENGTH=1000

# --- Network & CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
